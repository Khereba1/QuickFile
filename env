# ==========================================
# 🔑 الاعتمادات الأساسية (مطلوبة)
# ==========================================
API_ID=###
API_HASH=###
BOT_TOKEN=###

# ==========================================
# 🤖 مفاتيح واجهات برمجة التطبيقات (APIs)
# ==========================================
GEMINI_API_KEY=###
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
GEMINI_MODEL_BACKUP=gemini-3.5-flash-lite
# موديلات مستقلة للتفريغ والتلخيص (لو سبتهم فاضيين بيستخدموا الموديلين اللي فوق).
# لو جودة التفريغ بـ flash-lite مش كويسة، حط هنا موديل flash.
GEMINI_MODEL_TRANSCRIBE=gemini-3.5-flash
GEMINI_MODEL_TRANSCRIBE_BACKUP=gemini-3.8-flash
GEMINI_MODEL_SUMMARY=
GEMINI_MODEL_SUMMARY_BACKUP=
# 0 = سيب الافتراضي بتاع الموديل
GEMINI_MAX_OUTPUT_TOKENS=0
ILOVEPDF_PUBLIC_KEY=###
CLOUDCONVERT_API_KEY=###

# ==========================================
# 🏢 إعدادات الأرشفة (CRM)
# ==========================================
# ضع 0 أو احذف القيمة لإيقاف الأرشفة
ARCHIVE_GROUP_ID=-1003930706357

# ==========================================
# 🗜️ حدود الأحجام (بالميجا بايت)
# ==========================================
MAX_FILE_MB=1024
MAX_VIDEO_MB=350
MAX_AUDIO_MB=350
MAX_PDF_MB=50
MAX_OFFICE_MB=25
MAX_IMAGE_MB=10
MAX_IMAGES=40
MAX_PARTS=40

# ==========================================
# 🖥️ إعدادات الاستضافة والموارد
# ==========================================
# وضع الاستضافة الضعيفة (1 = مفعل، 0 = معطل)
LIGHT_HOST=1

# إجمالي مساحة التخزين المتاحة للبوت بالميجا بايت
DISK_TOTAL_MB=1024
# المساحة المخصصة لملفات العمل (الافتراضي 75% من DISK_TOTAL_MB)
WORK_BUDGET_MB=750

# أقصى عدد مهام للمستخدم الواحد
USER_MAX_JOBS=3
# عدد المهام التقيلة المتزامنة
MAX_RUNNING=1
MAX_HEAVY=1
# عدد المهام الخفيفة المتزامنة
QUICK_SLOTS=1

# ==========================================
# ⚙️ إعدادات FFMPEG
# ==========================================
FFMPEG_THREADS=1
FFMPEG_NICE=10
FFMPEG_CPU_PERCENT=35
# FFMPEG_PATH=
# FFMPEG_PRESET=veryfast

# ==========================================
# ⚡ إعدادات المهام السريعة (بدون طابور)
# ==========================================
QUICK_COPY_MB=60
QUICK_AUDIO_MB=12
QUICK_AUDIO_MIN=15
QUICK_VIDEO_MB=15
QUICK_VIDEO_SEC=120

# ==========================================
# ⏱️ مهلات العمليات (بالدقائق)
# ==========================================
SESSION_IDLE_MIN=30
VIDEO_TIMEOUT_MIN=120
AUDIO_TIMEOUT_MIN=30
PDF_TIMEOUT_MIN=10

# ==========================================
# 🎬 إعدادات ضغط الفيديو
# ==========================================
VIDEO_DEFAULT_MODE=fast
VIDEO_FAST_PRESET=ultrafast
VIDEO_QUALITY_PRESET=fast
VIDEO_FAST_CRF_ADD=3

# ==========================================
# 🆕 إضافات جديدة
# ==========================================
# القص الدقيق للفيديو على الاستضافة الضعيفة: أقصى مدة (بالدقايق) من الفيديو المحتفظ بيه
PRECISE_CUT_MAX_MIN=30

# عدد العمليات السحابية (iLovePDF / CloudConvert / Gemini) المتزامنة
CLOUD_SLOTS=2

# دمج الصوت/الفيديو
MAX_MERGE_FILES=10
# LIGHT_HOST فقط: أقصى مدة إجمالية (دقايق) لدمج فيديوهات مختلفة الصيغة (محتاج إعادة ترميز)
MERGE_REENCODE_MAX_MIN=30

# PDF الممسوح الكبير بيتبعت لـ Gemini على دفعات صفحات لو حجمه فوق ده أو عدد صفحاته +60
GEMINI_PDF_CHUNK_MB=8
GEMINI_PDF_CHUNK_PAGES=10

# التفريغ: الصوت اللي كل جزء منه أكبر من ده بيتضغط الأول، والتسجيلات الطويلة بتتقسم لأجزاء بالمدة دي
TRANSCRIBE_COMPRESS_ABOVE_MB=
TRANSCRIBE_CHUNK_MIN=45
# لو التفريغ/التلخيص أطول من عدد الرسائل ده بيتبعت كملف بدل رسائل في الشات
TRANSCRIPT_CHAT_MAX_MSGS=8

# ==========================================
# 📘 الكتب التفاعلية (.exe من Flip PDF / FlipBuilder) ← PDF
# ==========================================
# أكبر ملف .exe مقبول (بالميجا)
MAX_BOOK_MB=100
# لو أول X ميجا من الـ exe مفيهاش جدول الكتاب، البوت بيوقف التحميل ويرفضه (بيوفر على برامج التثبيت العادية)
BOOK_SNIFF_MB=24
# أقصى مدة للتحويل (بالدقايق)
BOOK_TIMEOUT_MIN=30
# سقف المعالج للتحويل (% من نواة واحدة) — الافتراضي نفس FFMPEG_CPU_PERCENT
BOOK_CPU_PERCENT=35
# سقف الرام لعملية التحويل (بالميجا)، 0 = بدون سقف
BOOK_MAX_RAM_MB=150
